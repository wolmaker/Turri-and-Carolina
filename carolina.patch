+
+    private interface Setting {
+        String title();
+        String value();
+        void change(int dir);
+    }
+
+    private Setting listSetting(String title, String key, String def, int namesRes, int valuesRes) {
+        final String[] names = game.getResources().getStringArray(namesRes);
+        final String[] values = game.getResources().getStringArray(valuesRes);
+        return new Setting() {
+            int index() {
+                String cur = prefs().getString(key, def);
+                for (int i = 0; i < values.length; i++) if (values[i].equals(cur)) return i;
+                return -1;
+            }
+            public String title() { return title; }
+            public String value() {
+                int i = index();
+                return i >= 0 && i < names.length ? names[i] : prefs().getString(key, def);
+            }
+            public void change(int dir) {
+                int i = index();
+                i = i < 0 ? 0 : (i + dir + values.length) % values.length;
+                prefs().edit().putString(key, values[i]).apply();
+            }
+        };
+    }
+
+    private Setting boolSetting(String title, String key, boolean def) {
+        return new Setting() {
+            public String title() { return title; }
+            public String value() { return prefs().getBoolean(key, def) ? "Activado" : "Desactivado"; }
+            public void change(int dir) { prefs().edit().putBoolean(key, !prefs().getBoolean(key, def)).apply(); }
+        };
+    }
+
+    private Setting intSetting(String title, String key, int def, int step, int min, int max, String suffix) {
+        return new Setting() {
+            public String title() { return title; }
+            public String value() { return prefs().getInt(key, def) + suffix; }
+            public void change(int dir) {
+                int v = Math.max(min, Math.min(max, prefs().getInt(key, def) + dir * step));
+                prefs().edit().putInt(key, v).apply();
+            }
+        };
+    }
+
+    private Setting bitrateSetting() {
+        final String key = "seekbar_bitrate_kbps";
+        return new Setting() {
+            int cur() {
+                int v = prefs().getInt(key, 0);
+                return v > 0 ? v : com.limelight.preferences.PreferenceConfiguration.getDefaultBitrate(game);
+            }
+            public String title() { return "Tasa de bits (calidad)"; }
+            public String value() {
+                int v = cur();
+                return (v % 1000 == 0 ? String.valueOf(v / 1000) : String.format(java.util.Locale.US, "%.1f", v / 1000f)) + " Mbps";
+            }
+            public void change(int dir) {
+                int v = cur();
+                int step = v < 10000 || (v == 10000 && dir < 0) ? 1000 : 5000;
+                v = Math.max(1000, Math.min(150000, v + dir * step));
+                prefs().edit().putInt(key, v).apply();
+            }
+        };
+    }
