+    private void renderGuide() {
+        if (guideRoot == null) return;
+        guideRoot.removeAllViews();
+        ImageView img = new ImageView(game);
+        img.setImageResource(R.drawable.carolina_mando);
+        img.setScaleType(ImageView.ScaleType.FIT_XY);
+        guideRoot.addView(img, new FrameLayout.LayoutParams(-1, -1));
+
+        final int layer = guidePage;
+        guideRoot.post(() -> {
+            if (guideRoot == null) return;
+            float w = guideRoot.getWidth(), h = guideRoot.getHeight();
+            float sx = w / 1920f, sy = h / 1080f;
+            for (int i = 0; i < ANCHORS.length; i++) {
+                TextView tv = new TextView(game);
+                tv.setText(bindings.describe(layer, i));
+                boolean sel = guideEdit && i == guideSlot;
+                tv.setTextColor(sel ? 0xFFFFFFFF : (PcBindings.editable(layer, i) ? 0xFFF2E6FF : 0xFFB0A0C8));
+                if (sel) {
+                    tv.setBackground(glass(0x88986FF2, 0xFFE0C8FF, 10, 2));
+                    tv.setPadding(dp(8), dp(2), dp(8), dp(2));
+                }
+                tv.setTextSize(TypedValue.COMPLEX_UNIT_PX, 22 * sy);
+                tv.setShadowLayer(6, 0, 0, Color.BLACK);
+                int boxW = (int) (420 * sx);
+                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(boxW, -2);
+                float ax = ANCHORS[i][0] * sx, ay = ANCHORS[i][1] * sy;
