+        LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+        clp.setMargins(dp(a, 4), dp(a, 10), dp(a, 4), dp(a, 10));
+        controls.addView(prev, clp);
+        controls.addView(playPause, clp);
+        controls.addView(next, clp);
+        panel.addView(controls, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView volLabel = new TextView(a);
+        volLabel.setText("Volumen de la música");
+        volLabel.setTextColor(0xFFBBAADD);
+        volLabel.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+        volLabel.setPadding(dp(a, 4), dp(a, 2), 0, dp(a, 4));
+        panel.addView(volLabel);
+        panel.addView(volumeBar(a), new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        Runnable refresh = () -> {
+            boolean playing = music != null && music.isPlaying();
+            for (int i = 0; i < rows.length; i++) {
+                boolean cur = i == track;
+                rows[i].setText((cur ? (playing ? "♪  " : "❚❚  ") : "      ") + TITLES[i]);
+                rows[i].setTextColor(cur ? 0xFFFFFFFF : 0xFFD8C8F0);
+            }
+            playPause.setText(playing ? "⏸" : "▶");
+        };
+        refresh.run();
+        playerRefresh = refresh;
+        playerRefreshByScreen.put(a, refresh);
+
+        FrameLayout.LayoutParams flp = new FrameLayout.LayoutParams(dp(a, PLAYER_WIDTH_DP),
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.END | Gravity.CENTER_VERTICAL);
+        flp.setMargins(0, dp(a, 40), dp(a, 16), 0);
+        root.addView(panel, flp);
+    }
+
+    /** "🔊 ———●———" volume bar; works with the TV remote (left / right when selected). */
+    private static View volumeBar(Activity a) {
+        LinearLayout box = new LinearLayout(a);
+        box.setOrientation(LinearLayout.HORIZONTAL);
+        box.setGravity(Gravity.CENTER_VERTICAL);
+        box.setPadding(dp(a, 12), dp(a, 2), dp(a, 6), dp(a, 2));
+        box.setBackground(glass(a));
+        TextView icon = new TextView(a);
+        icon.setTextColor(Color.WHITE);
+        icon.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        box.addView(icon);
+        android.widget.SeekBar sb = new android.widget.SeekBar(a);
+        sb.setMax(100);
+        sb.setKeyProgressIncrement(5);
+        sb.setProgress(prefs(a).getInt(KEY_VOLUME, DEFAULT_VOLUME));
+        android.content.res.ColorStateList purple = android.content.res.ColorStateList.valueOf(0xFFC8A0FF);
+        sb.setProgressTintList(purple);
+        sb.setThumbTintList(android.content.res.ColorStateList.valueOf(Color.WHITE));
+        sb.setProgressBackgroundTintList(android.content.res.ColorStateList.valueOf(0x66FFFFFF));
+        Runnable label = () -> icon.setText(sb.getProgress() == 0 ? "🔇" : "🔊 " + sb.getProgress() + "%");
+        label.run();
+        sb.setOnSeekBarChangeListener(new android.widget.SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(android.widget.SeekBar s, int p, boolean fromUser) {
+                prefs(a).edit().putInt(KEY_VOLUME, p).apply();
+                label.run();
+                if (music != null) {
+                    float v = volume(a) * 0.85f;
+                    music.setVolume(v, v);
+                }
+            }
+            @Override public void onStartTrackingTouch(android.widget.SeekBar s) { }
+            @Override public void onStopTrackingTouch(android.widget.SeekBar s) { }
+        });
+        sb.setOnFocusChangeListener((v, f) -> box.setSelected(f));
+        box.addView(sb, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+        return box;
+    }
+
+    // ------------------------------------------------------------ loading screen
+
+    /** Full-screen Carolina background shown while the stream is connecting. */
+    public static View showLoadingBackground(Activity a) {
+        try {
+            ViewGroup root = a.findViewById(android.R.id.content);
+            android.widget.ImageView iv = new android.widget.ImageView(a);
+            iv.setImageResource(R.drawable.carolina_loading);
+            iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
+            iv.setBackgroundColor(Color.BLACK);
+            root.addView(iv, new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+            return iv;
+        } catch (Exception e) {
+            LimeLog.warning("CarolinaAudio loading: " + e);
+            return null;
+        }
+    }
+
+    public static void hideLoadingBackground(View v) {
+        if (v != null && v.getParent() instanceof ViewGroup) {
+            ((ViewGroup) v.getParent()).removeView(v);
+        }
+    }
+}
diff --git a/app/src/main/java/com/limelight/utils/CarolinaSupport.java b/app/src/main/java/com/limelight/utils/CarolinaSupport.java
new file mode 100644
index 0000000..a5727f3
--- /dev/null
+++ b/app/src/main/java/com/limelight/utils/CarolinaSupport.java
@@ -0,0 +1,140 @@
+package com.limelight.utils;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.limelight.R;
+
+/**
+ * "Apoyar el proyecto": two QR codes (Patreon membership and the art-book shop)
+ * so the user can open them with a phone camera, since many TVs have no browser.
+ */
+public final class CarolinaSupport {
+    public static final String PATREON_URL = "https://www.patreon.com/c/jordan861/membership";
+    public static final String SHOP_URL = "https://www.patreon.com/c/jordan861/shop";
+
+    private CarolinaSupport() {
+    }
+
+    private static int dp(Context c, float v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.getResources().getDisplayMetrics());
+    }
+
+    private static TextView text(Context c, String s, float sp, int color, boolean bold) {
+        TextView t = new TextView(c);
+        t.setText(s);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setGravity(Gravity.CENTER);
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        return t;
+    }
+
+    private static View qrBox(Context c, int res, String title, String subtitle) {
+        LinearLayout box = new LinearLayout(c);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setGravity(Gravity.CENTER_HORIZONTAL);
+        box.setPadding(dp(c, 14), dp(c, 12), dp(c, 14), dp(c, 12));
+        GradientDrawable g = new GradientDrawable();
+        g.setColor(0x33986FF2);
+        g.setCornerRadius(dp(c, 18));
+        g.setStroke(dp(c, 1), 0x88C8A0FF);
+        box.setBackground(g);
+        box.addView(text(c, title, 17, 0xFFF2E6FF, true));
+        ImageView qr = new ImageView(c);
+        qr.setImageResource(res);
+        qr.setBackgroundColor(Color.WHITE);
+        qr.setPadding(dp(c, 4), dp(c, 4), dp(c, 4), dp(c, 4));
+        LinearLayout.LayoutParams qlp = new LinearLayout.LayoutParams(dp(c, 170), dp(c, 170));
+        qlp.setMargins(0, dp(c, 10), 0, dp(c, 10));
+        box.addView(qr, qlp);
+        TextView sub = text(c, subtitle, 13, 0xFFD8C8F0, false);
+        sub.setMaxWidth(dp(c, 220));
+        box.addView(sub);
+        return box;
+    }
+
+    /** The panel content (used by the in-game menu overlay and by the home-screen dialog). */
+    public static View buildView(Context c, String footer, Runnable onClose) {
+        LinearLayout root = new LinearLayout(c);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER_HORIZONTAL);
+        root.setPadding(dp(c, 24), dp(c, 18), dp(c, 24), dp(c, 18));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0xEE1A1030);
+        bg.setCornerRadius(dp(c, 24));
+        bg.setStroke(dp(c, 2), 0xFFB48CFF);
+        root.setBackground(bg);
+
+        root.addView(text(c, "Apoyar el proyecto 💜", 22, 0xFFEBD7FF, true));
+        TextView intro = text(c, "Turri y Carolina son gratis y siempre lo serán. Si te gustan y quieres ayudar a que sigan "
+                + "mejorando, escanea un código con la cámara de tu celular.", 14, 0xFFE6DCF5, false);
+        intro.setPadding(0, dp(c, 8), 0, dp(c, 14));
+        intro.setMaxWidth(dp(c, 560));
+        root.addView(intro);
+
+        LinearLayout row = new LinearLayout(c);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);
+        lp.setMargins(dp(c, 10), 0, dp(c, 10), 0);
+        row.addView(qrBox(c, R.drawable.carolina_qr_patreon, "Apoyo mensual",
+                "En Patreon, desde 1 dólar al mes"), lp);
+        row.addView(qrBox(c, R.drawable.carolina_qr_tienda, "Libros de arte",
+                "Compra un libro de dibujo restaurado: apoyas y te llevas un libro"), lp);
+        root.addView(row);
+
+        TextView thanks = text(c, "patreon.com/c/jordan861 · ¡Gracias de corazón!", 13, 0xFFBBAADD, false);
+        thanks.setPadding(0, dp(c, 14), 0, 0);
+        root.addView(thanks);
+        if (footer != null) {
+            TextView f = text(c, footer, 12, 0xFF9F8FC0, false);
+            f.setPadding(0, dp(c, 6), 0, 0);
+            root.addView(f);
+        }
+        if (onClose != null) {
+            TextView close = text(c, "Cerrar", 15, Color.WHITE, true);
+            close.setPadding(dp(c, 28), dp(c, 8), dp(c, 28), dp(c, 8));
+            GradientDrawable n = new GradientDrawable();
+            n.setColor(0x44986FF2); n.setCornerRadius(dp(c, 18)); n.setStroke(dp(c, 1), 0x88C8A0FF);
+            GradientDrawable f = new GradientDrawable();
+            f.setColor(0x88986FF2); f.setCornerRadius(dp(c, 18)); f.setStroke(dp(c, 2), 0xFFE0C8FF);
+            android.graphics.drawable.StateListDrawable st = new android.graphics.drawable.StateListDrawable();
+            st.addState(new int[]{android.R.attr.state_focused}, f);
+            st.addState(new int[]{android.R.attr.state_pressed}, f);
+            st.addState(new int[]{}, n);
+            close.setBackground(st);
+            close.setFocusable(true);
+            close.setClickable(true);
+            close.setOnClickListener(v -> onClose.run());
+            LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(-2, -2);
+            clp.topMargin = dp(c, 14);
+            root.addView(close, clp);
+            close.post(close::requestFocus);
+        }
+        return root;
+    }
+
+    /** Home screens: a dialog that works with the TV remote. */
+    public static void showDialog(Activity a) {
+        try {
+            final AlertDialog[] holder = new AlertDialog[1];
+            View v = buildView(a, null, () -> { if (holder[0] != null) holder[0].dismiss(); });
+            holder[0] = new AlertDialog.Builder(a).setView(v).create();
+            holder[0].show();
+            if (holder[0].getWindow() != null) {
+                holder[0].getWindow().setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(Color.TRANSPARENT));
+            }
+        } catch (Exception ignored) {
+        }
+    }
+}
