+    private void select() {
+        if (settingsRoot != null) {
+            if (settingIdx < settings.length) { settings[settingIdx].change(1); settingsChanged = true; renderSettings(); }
+            else if (settingIdx == settings.length) { closeSettingsBox(); close(); game.restartVideo(); }
+            else closeSettingsBox();
+            return;
+        }
+        if (closeSupport() || closeHelpBox()) return;
+        if (guideOpen) {
+            if (choices != null) {
+                bindings.set(guidePage, guideSlot, choices[choiceIdx]);
+                game.reloadPcModeSettings();
+                choices = null;
+            } else if (!guideEdit) {
+                closeGuide();
+                return;
+            } else if (PcBindings.editable(guidePage, guideSlot)) {
+                choices = PcBindings.choicesFor(guidePage, guideSlot);
+                choiceIdx = 0;
+                PcBindings.Action cur = bindings.get(guidePage, guideSlot);
+                for (int i = 0; i < choices.length; i++) if (choices[i] == cur) choiceIdx = i;
+            }
+            renderGuide();
+            return;
+        }
+        Item it = columns.get(col).get(row);
+        if (!it.keepOpen || it.action == null) {
+            close();
+        }
+        if (it.action != null) {
+            try { it.action.run(); } catch (Exception ignored) { }
+        }
+        if (it.keepOpen) handler.postDelayed(this::refresh, 150);
+    }
+
+    private void back() {
+        if (closeSettingsBox() || closeSupport() || closeHelpBox()) return;
+        if (guideOpen) {
+            if (choices != null) { choices = null; renderGuide(); }
+            else closeGuide();
+        } else close();
+    }
