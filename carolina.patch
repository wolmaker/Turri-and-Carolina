+        d[L3] = Action.TOGGLE_KEYBOARD; d[R3] = Action.CLICK_MIDDLE; d[MENU] = Action.KEY_ENTER; d[GUIDE] = Action.SHOW_DESKTOP;
+        d[LS] = Action.STICK_MOUSE; d[RS] = Action.STICK_SCROLL; d[DPAD] = Action.STICK_ARROWS;
+        Action[] v = DEFAULTS[DESK_VIEW];
+        v[B] = Action.CLOSE_WINDOW; v[X] = Action.SWITCH_WINDOW; v[LB] = Action.MEDIA_PREV; v[RB] = Action.MEDIA_NEXT;
+        v[LT] = Action.VOL_DOWN; v[RT] = Action.VOL_UP; v[R3] = Action.OPEN_GUIDE;
+        Action[] k = DEFAULTS[KB];
+        k[A] = Action.KB_TYPE; k[B] = Action.KB_ACCENTS; k[X] = Action.KEY_BACKSPACE; k[Y] = Action.KEY_SPACE;
+        k[LB] = Action.ARROW_LEFT; k[RB] = Action.ARROW_RIGHT; k[LT] = Action.KB_SYMBOLS; k[RT] = Action.KB_SHIFT;
+        k[L3] = Action.TOGGLE_KEYBOARD; k[R3] = Action.CLICK_LEFT; k[MENU] = Action.KEY_ENTER; k[GUIDE] = Action.SHOW_DESKTOP;
+        k[LS] = Action.STICK_MOUSE; k[RS] = Action.STICK_ARROWS; k[DPAD] = Action.DPAD_NAVIGATE;
+        Action[] kv = DEFAULTS[KB_VIEW];
+        kv[B] = Action.KEY_DELETE; kv[LT] = Action.VOL_DOWN; kv[RT] = Action.VOL_UP; kv[R3] = Action.OPEN_GUIDE;
+    }
+
+    private final Action[][] map = new Action[4][16];
+    private final Context context;
+
+    public PcBindings(Context c) {
+        context = c;
+        load();
+    }
+
+    private SharedPreferences prefs() {
+        return ProfilesManager.getInstance().getOverlayingSharedPreferences(context);
+    }
+
+    private static String key(int layer, int slot) {
+        return "pcmap_" + layer + "_" + slot;
+    }
+
+    public synchronized void load() {
+        SharedPreferences p = null;
+        try { p = prefs(); } catch (Exception ignored) { }
+        for (int l = 0; l < 4; l++) {
+            for (int s = 0; s < 16; s++) {
+                Action a = DEFAULTS[l][s];
+                if (p != null) {
+                    String v = p.getString(key(l, s), null);
+                    if (v != null) {
+                        try { a = Action.valueOf(v); } catch (Exception ignored) { }
+                    }
+                }
+                map[l][s] = a;
+            }
+        }
+    }
+
+    public synchronized Action get(int layer, int slot) {
+        return map[layer][slot];
+    }
+
+    public synchronized void set(int layer, int slot, Action a) {
+        map[layer][slot] = a;
+        try { prefs().edit().putString(key(layer, slot), a.name()).apply(); } catch (Exception ignored) { }
+    }
+
+    public synchronized void reset(int layer, int slot) {
+        map[layer][slot] = DEFAULTS[layer][slot];
+        try { prefs().edit().remove(key(layer, slot)).apply(); } catch (Exception ignored) { }
+    }
+
+    public synchronized void resetAll() {
+        SharedPreferences.Editor e = prefs().edit();
+        for (int l = 0; l < 4; l++) for (int s = 0; s < 16; s++) {
+            map[l][s] = DEFAULTS[l][s];
+            e.remove(key(l, s));
+        }
+        e.apply();
+    }
+
+    /** Whether a slot can be edited on a layer (View is the modifier; Menu with View toggles PC mode). */
+    public static boolean editable(int layer, int slot) {
+        if (slot == VIEW) return false;
+        if ((layer == DESK_VIEW || layer == KB_VIEW) && (slot == MENU || slot == LS || slot == RS || slot == DPAD)) return false;
+        if (layer == KB && slot == DPAD) return false; // needed to pick keys
+        return true;
+    }
+
+    public static Action[] choicesFor(int layer, int slot) {
+        if (slot == LS || slot == RS) return STICK_ACTIONS;
+        if (slot == DPAD) return DPAD_ACTIONS;
+        if (layer == KB || layer == KB_VIEW) {
+            Action[] all = new Action[BUTTON_ACTIONS.length + KB_EXTRA.length];
+            System.arraycopy(KB_EXTRA, 0, all, 0, KB_EXTRA.length);
+            System.arraycopy(BUTTON_ACTIONS, 0, all, KB_EXTRA.length, BUTTON_ACTIONS.length);
+            return all;
+        }
+        return BUTTON_ACTIONS;
+    }
+
+    /** Text shown on the guide for a slot. */
+    public synchronized String describe(int layer, int slot) {
+        if (slot == VIEW) return (layer == DESK_VIEW || layer == KB_VIEW) ? "(manténlo presionado)" : "Mantener: combinaciones";
+        if ((layer == DESK_VIEW || layer == KB_VIEW) && slot == MENU) return "Activar / desactivar Modo PC";
+        if ((layer == DESK_VIEW || layer == KB_VIEW) && (slot == LS || slot == RS || slot == DPAD)) return "—";
+        String t = map[layer][slot].label;
+        if (slot == MENU && layer == DESK) t += " · Mantener: menú de Carolina";
+        if (map[layer][slot] == Action.NONE) t = "—";
+        return t;
+    }
+}
