--- /dev/null
+++ b/app/src/main/java/com/limelight/binding/input/PcMode.java
@@ -0,0 +1,710 @@
+package com.limelight.binding.input;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.media.AudioManager;
+import android.media.ToneGenerator;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.text.SpannableString;
+import android.text.Spanned;
+import android.text.style.ForegroundColorSpan;
+import android.text.style.RelativeSizeSpan;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.limelight.LimeLog;
+import com.limelight.nvstream.NvConnection;
+import com.limelight.nvstream.input.ControllerPacket;
+import com.limelight.nvstream.input.KeyboardPacket;
+import com.limelight.nvstream.input.MouseButtonPacket;
+import com.limelight.profiles.ProfilesManager;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Carolina "Modo PC": use the gamepad as mouse and keyboard on the host PC.
+ *
+ * Written from scratch for Carolina. The button layout follows the user's own
+ * configuration (described in screenshots), with two changes requested by the user:
+ * the left stick keeps moving the mouse while the keyboard is open, and R3 clicks.
+ *
+ * Toggle: hold View (Back) + Menu (Start).
+ */
+public class PcMode {
+    // ---- Virtual-key codes (Windows) ----
+    private static final int VK_BACK = 0x08, VK_TAB = 0x09, VK_RETURN = 0x0D, VK_CONTROL = 0x11,
+            VK_MENU = 0x12, VK_ESCAPE = 0x1B, VK_LEFT = 0x25, VK_UP = 0x26, VK_RIGHT = 0x27,
+            VK_DOWN = 0x28, VK_DELETE = 0x2E, VK_D = 0x44, VK_LWIN = 0x5B, VK_VOLUME_DOWN = 0xAE,
+            VK_VOLUME_UP = 0xAF, VK_MEDIA_NEXT = 0xB0, VK_MEDIA_PREV = 0xB1;
+
+    private static final long TICK_MS = 8;
+    private static final long REPEAT_DELAY_MS = 450;
+    private static final long REPEAT_RATE_MS = 45;
+    private static final long NAV_REPEAT_RATE_MS = 110;
+
+    private static final int PURPLE = 0xFF9870F2;
+    private static final int YELLOW = 0xFFFBB71B;
+
+    private final Activity activity;
+    private final NvConnection conn;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+
+    // State (guarded by "this")
+    private boolean active = false;
+    private boolean keyboardOpen = false;
+    private boolean helpOpen = false;
+    private int prevMap = 0;
+    private boolean prevLt = false, prevRt = false;
+    private boolean comboLatched = false;
+    private short lsx, lsy, rsx, rsy;
+    private boolean ltHeld = false;
+    private int heldMap = 0;
+    private final Map<Integer, Long> repeatNext = new HashMap<>();
+
+    // Settings
+    private float speed = 0.6f, accel = 0.5f, scrollSpeed = 0.8f;
+    private float deadL = 0.24f, deadR = 0.27f;
+    private boolean sound = true, enabled = true;
+
+    // Fractional accumulators
+    private float accX, accY, accSV, accSH;
+    private boolean ticking = false;
+
+    // Keyboard state
+    private boolean shift = false, caps = false, accents = false;
+    private long lastShiftPress = 0;
+    private int selRow = 1, selCol = 1;
+    private int rsDir = 0; // keyboard mode: right stick as arrows
+
+    // UI
+    private LinearLayout keyboardView;
+    private TextView helpView;
+    private TextView[][] cells;
+
+    public PcMode(Activity activity, NvConnection conn) {
+        this.activity = activity;
+        this.conn = conn;
+        loadSettings();
+    }
+
+    public void loadSettings() {
+        try {
+            SharedPreferences p = ProfilesManager.getInstance().getOverlayingSharedPreferences(activity);
+            enabled = p.getBoolean("checkbox_pc_mode", true);
+            speed = p.getInt("seekbar_pc_mouse_speed", 60) / 100f;
+            accel = p.getInt("seekbar_pc_mouse_accel", 50) / 100f;
+            scrollSpeed = p.getInt("seekbar_pc_scroll_speed", 80) / 100f;
+            deadL = p.getInt("seekbar_pc_deadzone_left", 24) / 100f;
+            deadR = p.getInt("seekbar_pc_deadzone_right", 27) / 100f;
+            sound = p.getBoolean("checkbox_pc_mode_sound", true);
+        } catch (Exception e) {
+            LimeLog.warning("PcMode: could not load settings: " + e);
+        }
+    }
+
+    public synchronized boolean isActive() {
+        return active;
+    }
+
+    /**
+     * Called with the aggregated state of controller 1. Returns true if the input was
+     * consumed (and the game must receive a neutral controller state instead).
+     */
+    public synchronized boolean handle(int map, byte lt, byte rt, short lx, short ly, short rx, short ry) {
+        if (!enabled) {
+            return false;
+        }
+        boolean ltDown = (lt & 0xFF) > 100;
+        boolean rtDown = (rt & 0xFF) > 100;
+
+        // Toggle with View + Menu
+        boolean combo = (map & ControllerPacket.BACK_FLAG) != 0 && (map & ControllerPacket.PLAY_FLAG) != 0;
+        if (combo && !comboLatched) {
+            comboLatched = true;
+            setActive(!active);
+            prevMap = map;
+            prevLt = ltDown;
+            prevRt = rtDown;
+            return true;
+        }
+        if (comboLatched) {
+            if ((map & (ControllerPacket.BACK_FLAG | ControllerPacket.PLAY_FLAG)) == 0) {
+                comboLatched = false;
+            }
+            prevMap = map;
+            prevLt = ltDown;
+            prevRt = rtDown;
+            return true;
+        }
+
+        if (!active) {
+            return false;
+        }
+
+        lsx = lx; lsy = ly; rsx = rx; rsy = ry;
+        ltHeld = ltDown;
+        heldMap = map;
+
+        int pressed = map & ~prevMap;
+        int released = ~map & prevMap;
+        boolean ltPressed = ltDown && !prevLt, rtPressed = rtDown && !prevRt;
+        boolean ltReleased = !ltDown && prevLt;
+        boolean secondary = (map & ControllerPacket.BACK_FLAG) != 0;
+
+        if (keyboardOpen) {
+            handleKeyboardButtons(map, pressed, released, ltPressed, ltReleased, rtPressed, secondary);
+        } else {
+            handleDesktopButtons(map, pressed, released, ltPressed, rtPressed, secondary);
+        }
+
+        prevMap = map;
+        prevLt = ltDown;
+        prevRt = rtDown;
+        ensureTicking();
+        return true;
+    }
+
+    // ------------------------------------------------------------------ desktop
+
+    private void handleDesktopButtons(int map, int pressed, int released, boolean ltPressed, boolean rtPressed, boolean secondary) {
+        if (secondary) {
+            if (has(pressed, ControllerPacket.B_FLAG)) combo(VK_LWIN, VK_D);
+            if (has(pressed, ControllerPacket.X_FLAG)) combo(VK_CONTROL, VK_MENU, VK_TAB);
+            if (has(pressed, ControllerPacket.LB_FLAG)) tap(VK_MEDIA_PREV);
+            if (has(pressed, ControllerPacket.RB_FLAG)) tap(VK_MEDIA_NEXT);
+            if (ltPressed) tap(VK_VOLUME_DOWN);
+            if (rtPressed) tap(VK_VOLUME_UP);
+            if (has(pressed, ControllerPacket.RS_CLK_FLAG)) toggleHelp();
+        } else {
+            mouseButton(pressed, released, ControllerPacket.A_FLAG, MouseButtonPacket.BUTTON_LEFT);
+            mouseButton(pressed, released, ControllerPacket.X_FLAG, MouseButtonPacket.BUTTON_RIGHT);
+            mouseButton(pressed, released, ControllerPacket.RS_CLK_FLAG, MouseButtonPacket.BUTTON_MIDDLE);
+            if (has(pressed, ControllerPacket.B_FLAG)) tap(VK_ESCAPE);
+            if (has(pressed, ControllerPacket.PLAY_FLAG)) tap(VK_RETURN);
+            repeatable(pressed, ControllerPacket.LEFT_FLAG, VK_LEFT);
+            repeatable(pressed, ControllerPacket.RIGHT_FLAG, VK_RIGHT);
+            repeatable(pressed, ControllerPacket.UP_FLAG, VK_UP);
+            repeatable(pressed, ControllerPacket.DOWN_FLAG, VK_DOWN);
+            if (has(pressed, ControllerPacket.LS_CLK_FLAG)) setKeyboardOpen(true);
+        }
+        // Release mouse buttons even if View was pressed in between
+        if (secondary) {
+            mouseButton(0, released, ControllerPacket.A_FLAG, MouseButtonPacket.BUTTON_LEFT);
+            mouseButton(0, released, ControllerPacket.X_FLAG, MouseButtonPacket.BUTTON_RIGHT);
+            mouseButton(0, released, ControllerPacket.RS_CLK_FLAG, MouseButtonPacket.BUTTON_MIDDLE);
+        }
+        clearReleasedRepeats(released);
+    }
+
+    // ------------------------------------------------------------------ keyboard
+
+    private void handleKeyboardButtons(int map, int pressed, int released, boolean ltPressed, boolean ltReleased, boolean rtPressed, boolean secondary) {
+        if (secondary) {
+            if (has(pressed, ControllerPacket.B_FLAG)) repeatable(pressed, ControllerPacket.B_FLAG, VK_DELETE);
+            if (ltPressed) tap(VK_VOLUME_DOWN);
+            if (rtPressed) tap(VK_VOLUME_UP);
+            if (has(pressed, ControllerPacket.RS_CLK_FLAG)) toggleHelp();
+        } else {
+            if (has(pressed, ControllerPacket.A_FLAG)) typeSelected();
+            if (has(pressed, ControllerPacket.B_FLAG)) { accents = !accents; refreshKeyboard(); }
+            repeatable(pressed, ControllerPacket.X_FLAG, VK_BACK);
+            repeatableText(pressed, ControllerPacket.Y_FLAG, " ");
+            repeatable(pressed, ControllerPacket.PLAY_FLAG, VK_RETURN);
+            repeatable(pressed, ControllerPacket.LB_FLAG, VK_LEFT);
+            repeatable(pressed, ControllerPacket.RB_FLAG, VK_RIGHT);
+            if (rtPressed) pressShift();
+            if (ltPressed || ltReleased) refreshKeyboard();
+            if (has(pressed, ControllerPacket.LS_CLK_FLAG)) { setKeyboardOpen(false); return; }
+            // D-pad navigates the keyboard
+            navRepeat(pressed, ControllerPacket.LEFT_FLAG, 0, -1);
+            navRepeat(pressed, ControllerPacket.RIGHT_FLAG, 0, 1);
+            navRepeat(pressed, ControllerPacket.UP_FLAG, -1, 0);
+            navRepeat(pressed, ControllerPacket.DOWN_FLAG, 1, 0);
+        }
+        // R3 = left click (so the left stick can still pick another text box)
+        if (!secondary || has(released, ControllerPacket.RS_CLK_FLAG)) {
+            mouseButton(secondary ? 0 : pressed, released, ControllerPacket.RS_CLK_FLAG, MouseButtonPacket.BUTTON_LEFT);
+        }
+        clearReleasedRepeats(released);
+    }
+
+    // ------------------------------------------------------------------ periodic tick (mouse, scroll, repeats)
+
+    private void ensureTicking() {
+        if (!ticking) {
+            ticking = true;
+            handler.post(tick);
+        }
+    }
+
+    private final Runnable tick = new Runnable() {
+        @Override
+        public void run() {
+            synchronized (PcMode.this) {
+                if (!active) {
+                    ticking = false;
+                    return;
+                }
+                doMouse();
+                doScrollOrArrows();
+                doRepeats();
+            }
+            handler.postDelayed(this, TICK_MS);
+        }
+    };
+
+    private float curve(float norm, float exponentBase) {
+        return (float) Math.pow(norm, 1.0 + exponentBase * 2.0);
+    }
+
+    private float[] applyDeadzone(short x, short y, float dz) {
+        float fx = x / 32767f, fy = y / 32767f;
+        float mag = (float) Math.min(1.0, Math.hypot(fx, fy));
+        if (mag <= dz || mag == 0) return null;
+        float norm = (mag - dz) / (1f - dz);
+        return new float[]{fx / mag, fy / mag, norm};
+    }
+
+    private void doMouse() {
+        float[] v = applyDeadzone(lsx, lsy, deadL);
+        if (v == null) { accX = accY = 0; return; }
+        float maxPx = 2f + speed * 38f;          // pixels per 8 ms tick at full deflection
+        float s = curve(v[2], accel) * maxPx;
+        if (ltHeld && !keyboardOpen) s *= 0.3f;  // precision while holding LT (desktop)
+        accX += v[0] * s;
+        accY += -v[1] * s;                      // stick up = cursor up
+        short dx = (short) accX, dy = (short) accY;
+        if (dx != 0 || dy != 0) {
+            conn.sendMouseMove(dx, dy);
+            accX -= dx; accY -= dy;
+        }
+    }
+
+    private void doScrollOrArrows() {
+        float[] v = applyDeadzone(rsx, rsy, deadR);
+        if (keyboardOpen) {
+            int dir = 0;
+            if (v != null && v[2] > 0.35f) {
+                if (Math.abs(v[0]) > Math.abs(v[1])) dir = v[0] > 0 ? VK_RIGHT : VK_LEFT;
+                else dir = v[1] > 0 ? VK_UP : VK_DOWN;
+            }
+            if (dir != rsDir) {
+                repeatNext.remove(-rsDir);
+                rsDir = dir;
+                if (dir != 0) {
+                    tap(dir);
+                    repeatNext.put(-dir, SystemClock.uptimeMillis() + REPEAT_DELAY_MS);
+                }
+            }
+            return;
+        }
+        if (v == null) { accSV = accSH = 0; return; }
+        float max = 4f + scrollSpeed * 44f;      // 120 = one wheel notch
+        float s = curve(v[2], 0.5f) * max;
+        accSV += v[1] * s;
+        accSH += v[0] * s;
+        short sv = (short) accSV, sh = (short) accSH;
+        if (sv != 0) { conn.sendMouseHighResScroll(sv); accSV -= sv; }
+        if (sh != 0) { conn.sendMouseHighResHScroll(sh); accSH -= sh; }
+    }
+
+    // Repeat entries: key > 0 -> button flag (repeat action stored separately); key < 0 -> right-stick arrow VK
+    private final Map<Integer, Runnable> repeatActions = new HashMap<>();
+    private final Map<Integer, Long> repeatRates = new HashMap<>();
+
+    private void doRepeats() {
+        long now = SystemClock.uptimeMillis();
+        for (Map.Entry<Integer, Long> e : new HashMap<>(repeatNext).entrySet()) {
+            int id = e.getKey();
+            if (now < e.getValue()) continue;
+            if (id < 0) {
+                tap(-id);
+                repeatNext.put(id, now + REPEAT_RATE_MS);
+            } else if ((heldMap & id) != 0) {
+                Runnable r = repeatActions.get(id);
+                if (r != null) r.run();
+                Long rate = repeatRates.get(id);
+                repeatNext.put(id, now + (rate != null ? rate : REPEAT_RATE_MS));
+            } else {
+                repeatNext.remove(id);
+            }
+        }
+    }
+
+    private void startRepeat(int flag, Runnable action, long rate) {
+        action.run();
+        repeatActions.put(flag, action);
+        repeatRates.put(flag, rate);
+        repeatNext.put(flag, SystemClock.uptimeMillis() + REPEAT_DELAY_MS);
+    }
+
+    private void repeatable(int pressed, int flag, final int vk) {
+        if (has(pressed, flag)) startRepeat(flag, () -> tap(vk), REPEAT_RATE_MS);
+    }
+
+    private void repeatableText(int pressed, int flag, final String text) {
+        if (has(pressed, flag)) startRepeat(flag, () -> conn.sendUtf8Text(text), REPEAT_RATE_MS);
+    }
+
+    private void navRepeat(int pressed, int flag, final int dr, final int dc) {
+        if (has(pressed, flag)) startRepeat(flag, () -> moveSelection(dr, dc), NAV_REPEAT_RATE_MS);
+    }
+
+    private void clearReleasedRepeats(int released) {
+        for (Integer id : new HashMap<>(repeatNext).keySet()) {
+            if (id > 0 && (released & id) != 0) repeatNext.remove(id);
+        }
+    }
+
+    // ------------------------------------------------------------------ sending helpers
+
+    private static boolean has(int mask, int flag) {
+        return (mask & flag) != 0;
+    }
+
+    private short vk(int code) {
+        return (short) (0x8000 | code);
+    }
+
+    private byte modifierFor(int code) {
+        switch (code) {
+            case VK_CONTROL: return KeyboardPacket.MODIFIER_CTRL;
+            case VK_MENU: return KeyboardPacket.MODIFIER_ALT;
+            case VK_LWIN: return KeyboardPacket.MODIFIER_META;
+            default: return 0;
+        }
+    }
+
+    private void tap(int code) {
+        conn.sendKeyboardInput(vk(code), KeyboardPacket.KEY_DOWN, (byte) 0, (byte) 0);
+        conn.sendKeyboardInput(vk(code), KeyboardPacket.KEY_UP, (byte) 0, (byte) 0);
+    }
+
+    private void combo(int... codes) {
+        byte mods = 0;
+        for (int c : codes) {
+            conn.sendKeyboardInput(vk(c), KeyboardPacket.KEY_DOWN, mods, (byte) 0);
+            mods |= modifierFor(c);
+        }
+        for (int i = codes.length - 1; i >= 0; i--) {
+            mods &= ~modifierFor(codes[i]);
+            conn.sendKeyboardInput(vk(codes[i]), KeyboardPacket.KEY_UP, mods, (byte) 0);
+        }
+    }
+
+    private void mouseButton(int pressed, int released, int flag, byte button) {
+        if (has(pressed, flag)) conn.sendMouseButtonDown(button);
+        if (has(released, flag)) conn.sendMouseButtonUp(button);
+    }
+
+    private void releaseEverything() {
+        conn.sendMouseButtonUp(MouseButtonPacket.BUTTON_LEFT);
+        conn.sendMouseButtonUp(MouseButtonPacket.BUTTON_RIGHT);
+        conn.sendMouseButtonUp(MouseButtonPacket.BUTTON_MIDDLE);
+        repeatNext.clear();
+        rsDir = 0;
+    }
+
+    // ------------------------------------------------------------------ mode switching
+
+    private void setActive(boolean on) {
+        if (active == on) return;
+        active = on;
+        if (!on) {
+            releaseEverything();
+            if (keyboardOpen) setKeyboardOpen(false);
+            if (helpOpen) toggleHelp();
+        }
+        final boolean shown = on;
+        handler.post(() -> {
+            Toast.makeText(activity, shown ? "Modo PC activado (View + Menú para salir)" : "Modo PC desactivado",
+                    Toast.LENGTH_SHORT).show();
+            if (sound) beep(shown);
+        });
+        if (on) ensureTicking();
+    }
+
+    public synchronized void toggleFromMenu() {
+        setActive(!active);
+    }
+
+    public synchronized void openKeyboardFromMenu() {
+        if (!active) setActive(true);
+        setKeyboardOpen(true);
+    }
+
+    public synchronized void stop() {
+        if (active) {
+            active = false;
+            releaseEverything();
+        }
+        handler.post(this::removeViews);
+    }
+
+    private void beep(boolean on) {
+        try {
+            ToneGenerator tg = new ToneGenerator(AudioManager.STREAM_NOTIFICATION, 60);
+            tg.startTone(on ? ToneGenerator.TONE_PROP_ACK : ToneGenerator.TONE_PROP_NACK, 150);
+            handler.postDelayed(tg::release, 400);
+        } catch (Exception ignored) {
+        }
+    }
+
+    private void setKeyboardOpen(boolean open) {
+        keyboardOpen = open;
+        repeatNext.clear();
+        rsDir = 0;
+        if (!open) { shift = false; accents = false; }
+        handler.post(() -> {
+            if (open) showKeyboard(); else hideKeyboard();
+        });
+    }
+
+    // ------------------------------------------------------------------ keyboard model
+
+    // Each row has 12 cells. Special cells are marked with a leading '\u0001' code.
+    private static final String SYM = "\u0001SYM", BKSP = "\u0001BKSP", LEFT = "\u0001LEFT", RIGHT = "\u0001RIGHT",
+            SHIFT = "\u0001SHIFT", ENTER = "\u0001ENTER", CLOSE = "\u0001CLOSE", ACC = "\u0001ACC", SPACE = "\u0001SPACE";
+
+    private static final String[][] BASE = {
+            {SYM, "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", BKSP},
+            {LEFT, "q", "w", "e", "r", "t", "y", "u", "i", "o", "p", RIGHT},
+            {SHIFT, "a", "s", "d", "f", "g", "h", "j", "k", "l", "ñ", ENTER},
+            {CLOSE, "z", "x", "c", "v", "b", "n", "m", ",", ".", "-", ACC},
+            {SPACE},
+    };
+    private static final String[][] SYMBOLS = {
+            {SYM, "!", "\"", "#", "$", "%", "&", "/", "(", ")", "=", BKSP},
+            {LEFT, "¿", "?", "¡", "'", "+", "*", "[", "]", "{", "}", RIGHT},
+            {SHIFT, "@", "<", ">", ":", ";", "_", "^", "~", "|", "\\", ENTER},
+            {CLOSE, "€", "°", "º", "ª", "`", "´", "¨", "ü", "ç", "·", ACC},
+            {SPACE},
+    };
+
+    private String charAt(int r, int c) {
+        String[][] grid = ltHeld ? SYMBOLS : BASE;
+        String s = grid[r][Math.min(c, grid[r].length - 1)];
+        if (s.startsWith("\u0001")) return s;
+        if (!ltHeld && accents) {
+            switch (s) {
+                case "a": s = "á"; break;
+                case "e": s = "é"; break;
+                case "i": s = "í"; break;
+                case "o": s = "ó"; break;
+                case "u": s = "ú"; break;
+                case "n": s = "ñ"; break;
+            }
+        }
+        if (shift || caps) s = s.toUpperCase();
+        return s;
+    }
+
+    private void moveSelection(int dr, int dc) {
+        int rows = BASE.length;
+        if (dr != 0) {
+            selRow = (selRow + dr + rows) % rows;
+        }
+        if (dc != 0 && BASE[selRow].length > 1) {
+            selCol = (selCol + dc + 12) % 12;
+        }
+        refreshKeyboard();
+    }
+
+    private void typeSelected() {
+        String k = charAt(selRow, selRow == 4 ? 0 : selCol);
+        switch (k) {
+            case SYM: return; // hold LT instead
+            case BKSP: tap(VK_BACK); return;
+            case LEFT: tap(VK_LEFT); return;
+            case RIGHT: tap(VK_RIGHT); return;
+            case SHIFT: pressShift(); return;
+            case ENTER: tap(VK_RETURN); return;
+            case CLOSE: setKeyboardOpen(false); return;
+            case ACC: accents = !accents; refreshKeyboard(); return;
+            case SPACE: conn.sendUtf8Text(" "); return;
+            default:
+                conn.sendUtf8Text(k);
+                if (shift && !caps) { shift = false; refreshKeyboard(); }
+        }
+    }
+
+    private void pressShift() {
+        long now = SystemClock.uptimeMillis();
+        if (now - lastShiftPress < 400) {
+            caps = !caps;
+            shift = false;
+        } else if (caps) {
+            caps = false;
+        } else {
+            shift = !shift;
+        }
+        lastShiftPress = now;
+        refreshKeyboard();
+    }
+
+    // ------------------------------------------------------------------ keyboard UI (main thread)
+
+    private int dp(float v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, activity.getResources().getDisplayMetrics());
+    }
+
+    private ViewGroup root() {
+        return activity.findViewById(android.R.id.content);
+    }
+
+    private void showKeyboard() {
+        if (keyboardView == null) {
+            keyboardView = new LinearLayout(activity);
+            keyboardView.setOrientation(LinearLayout.VERTICAL);
+            keyboardView.setPadding(dp(8), dp(8), dp(8), dp(8));
+            GradientDrawable bg = new GradientDrawable();
+            bg.setColor(0xE6101014);
+            bg.setCornerRadius(dp(14));
+            keyboardView.setBackground(bg);
+            cells = new TextView[BASE.length][];
+            for (int r = 0; r < BASE.length; r++) {
+                LinearLayout row = new LinearLayout(activity);
+                row.setOrientation(LinearLayout.HORIZONTAL);
+                cells[r] = new TextView[BASE[r].length];
+                for (int c = 0; c < BASE[r].length; c++) {
+                    TextView t = new TextView(activity);
+                    t.setGravity(Gravity.CENTER);
+                    t.setTextColor(Color.WHITE);
+                    t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+                    t.setTypeface(Typeface.DEFAULT_BOLD);
+                    float weight = (c == 0 || c == BASE[r].length - 1) && BASE[r].length > 1 ? 1.6f : 1f;
+                    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, dp(46), weight);
+                    lp.setMargins(dp(3), dp(3), dp(3), dp(3));
+                    row.addView(t, lp);
+                    cells[r][c] = t;
+                }
+                keyboardView.addView(row, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+            }
+            TextView foot = new TextView(activity);
+            foot.setTextColor(0xFFBBBBBB);
+            foot.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+            foot.setGravity(Gravity.CENTER);
+            foot.setText("Cruceta: elegir tecla · A: escribir · Stick izq.: mouse · R3: clic · View + R3: ayuda");
+            keyboardView.addView(foot);
+            FrameLayout.LayoutParams flp = new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+            flp.setMargins(dp(40), 0, dp(40), dp(16));
+            root().addView(keyboardView, flp);
+        }
+        keyboardView.setVisibility(View.VISIBLE);
+        keyboardView.bringToFront();
+        refreshKeyboardNow();
+    }
+
+    private void hideKeyboard() {
+        if (keyboardView != null) keyboardView.setVisibility(View.GONE);
+    }
+
+    private void refreshKeyboard() {
+        handler.post(this::refreshKeyboardNow);
+    }
+
+    private CharSequence labelWithHint(String label, String hint) {
+        SpannableString s = new SpannableString(label + "  " + hint);
+        int start = label.length() + 2;
+        s.setSpan(new RelativeSizeSpan(0.7f), start, s.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        s.setSpan(new ForegroundColorSpan(YELLOW), start, s.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return s;
+    }
+
+    private void refreshKeyboardNow() {
+        if (keyboardView == null || cells == null) return;
+        int sr, sc;
+        boolean sym, shf, cp, acc;
+        synchronized (this) {
+            sr = selRow; sc = selCol; sym = ltHeld; shf = shift; cp = caps; acc = accents;
+        }
+        for (int r = 0; r < cells.length; r++) {
+            for (int c = 0; c < cells[r].length; c++) {
+                String k;
+                synchronized (this) { k = charAt(r, c); }
+                CharSequence label;
+                switch (k) {
+                    case SYM: label = labelWithHint(sym ? "abc" : "#+=", "LT"); break;
+                    case BKSP: label = labelWithHint("⌫", "X"); break;
+                    case LEFT: label = labelWithHint("‹", "LB"); break;
+                    case RIGHT: label = labelWithHint("›", "RB"); break;
+                    case SHIFT: label = labelWithHint(cp ? "⇪" : "⇧", "RT"); break;
+                    case ENTER: label = labelWithHint("↵", "≡"); break;
+                    case CLOSE: label = labelWithHint("Cerrar", "L3"); break;
+                    case ACC: label = labelWithHint("Acentos", "B"); break;
+                    case SPACE: label = labelWithHint("espacio", "Y"); break;
+                    default: label = k;
+                }
+                TextView t = cells[r][c];
+                t.setText(label);
+                boolean selected = (r == sr) && (r == 4 || c == sc);
+                boolean highlighted = (k.equals(SHIFT) && (shf || cp)) || (k.equals(ACC) && acc) || (k.equals(SYM) && sym);
+                GradientDrawable d = new GradientDrawable();
+                d.setCornerRadius(dp(8));
+                d.setColor(highlighted ? 0xFF4A3A7A : (k.startsWith("\u0001") ? 0xFF24242C : 0xFF34343F));
+                if (selected) d.setStroke(dp(3), PURPLE);
+                t.setBackground(d);
+            }
+        }
+    }
+
+    private void toggleHelp() {
+        helpOpen = !helpOpen;
+        final boolean show = helpOpen;
+        handler.post(() -> {
+            if (helpView == null) {
+                helpView = new TextView(activity);
+                helpView.setTextColor(Color.WHITE);
+                helpView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 15);
+                helpView.setPadding(dp(20), dp(16), dp(20), dp(16));
+                GradientDrawable bg = new GradientDrawable();
+                bg.setColor(0xEE101014);
+                bg.setCornerRadius(dp(14));
+                bg.setStroke(dp(2), PURPLE);
+                helpView.setBackground(bg);
+                helpView.setText("MODO PC — ayuda (View + R3 para cerrar)\n\n" +
+                        "ESCRITORIO\n" +
+                        "Stick izq.: mouse · Stick der.: desplazar · LT: mouse lento\n" +
+                        "A: clic izq. · X: clic der. · R3: clic central · B: Esc · Menú: Enter\n" +
+                        "Cruceta: flechas · L3: abrir teclado\n\n" +
+                        "CON VIEW PRESIONADO\n" +
+                        "Menú: activar/desactivar Modo PC · B: ver escritorio · X: cambiar ventana\n" +
+                        "LB/RB: canción anterior/siguiente · LT/RT: volumen − / +\n\n" +
+                        "TECLADO\n" +
+                        "Cruceta: elegir tecla · A: escribir · X: borrar · Y: espacio · Menú: Enter\n" +
+                        "LB/RB: mover cursor · RT: mayúsculas (doble = bloq.) · LT: símbolos\n" +
+                        "B: acentos · L3: cerrar · Stick izq.: mouse · R3: clic · Stick der.: flechas\n" +
+                        "View + B: Suprimir");
+                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER);
+                root().addView(helpView, lp);
+            }
+            helpView.setVisibility(show ? View.VISIBLE : View.GONE);
+            if (show) helpView.bringToFront();
+        });
+    }
+
+    private void removeViews() {
+        try {
+            if (keyboardView != null) root().removeView(keyboardView);
+            if (helpView != null) root().removeView(helpView);
+        } catch (Exception ignored) {
+        }
+        keyboardView = null;
+        helpView = null;
+        cells = null;
+    }
+}
