+package com.limelight.utils;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.media.MediaPlayer;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.limelight.LimeLog;
+import com.limelight.R;
+
+/**
+ * Carolina sounds:
+ *  - greeting when Carolina opens (first seconds of "Mi luz y mi guía")
+ *  - short sound when an app (Escritorio, Steam...) is started ("Escribiendo el amor")
+ *  - background music on the home screens: both songs, one after the other, in a loop
+ *  - two buttons (top right) to mute the greeting and the music; choices are remembered
+ */
+public final class CarolinaAudio {
+    private static final String PREFS = "carolina_audio";
+    private static final String KEY_MUSIC = "music_on";
+    private static final String KEY_GREETING = "greeting_on";
+    private static final String KEY_VOLUME = "volume";       // 0..100, for the songs and the greetings
+    private static final int DEFAULT_VOLUME = 50;
+    private static final int[] PLAYLIST = {R.raw.carolina_musica_1, R.raw.carolina_musica_2};
+    private static final String[] TITLES = {"Mi luz y mi guía", "Escribiendo el amor"};
+    private static final String KEY_TRACK = "track";
+    /** Refreshes the player panel that is currently on screen (if any). */
+    private static Runnable playerRefresh;
+    private static final java.util.WeakHashMap<Activity, Runnable> playerRefreshByScreen = new java.util.WeakHashMap<>();
+
+    private static final Handler handler = new Handler(Looper.getMainLooper());
+    private static MediaPlayer music;
+    private static int track = 0;
+    private static int homeScreensVisible = 0;
+    private static boolean greetedThisLaunch = false;
+
+    private CarolinaAudio() {
+    }
+
+    private static SharedPreferences prefs(Context c) {
+        return c.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public static boolean isMusicOn(Context c) {
+        return prefs(c).getBoolean(KEY_MUSIC, true);
+    }
+
+    /** Volume chosen with the bar (0..1), with a curve so the low end is usable. */
+    private static float volume(Context c) {
+        float v = prefs(c).getInt(KEY_VOLUME, DEFAULT_VOLUME) / 100f;
+        return v * v;
+    }
+
+    public static boolean isGreetingOn(Context c) {
+        return prefs(c).getBoolean(KEY_GREETING, true);
+    }
+
+    // ------------------------------------------------------------ one-shot sounds
+
+    private static void playOnce(Context c, int res) {
+        try {
+            MediaPlayer mp = MediaPlayer.create(c.getApplicationContext(), res);
+            if (mp == null) return;
+            mp.setVolume(volume(c), volume(c));
+            mp.setOnCompletionListener(MediaPlayer::release);
+            mp.start();
+        } catch (Exception e) {
+            LimeLog.warning("CarolinaAudio: " + e);
+        }
+    }
+
+    /** A stream is starting (Escritorio, Steam, ...): stop music, play the short sound. */
+    public static void onAppLaunch(Context c) {
+        pauseMusic();
+        if (isGreetingOn(c)) {
+            playOnce(c, R.raw.carolina_abrir_app);
+        }
+    }
+
+    // ------------------------------------------------------------ background music
+
+    private static void startTrack(Context c) {
+        releaseMusic();
+        try {
+            music = MediaPlayer.create(c.getApplicationContext(), PLAYLIST[track % PLAYLIST.length]);
+            if (music == null) return;
+            float v = volume(c) * 0.85f; // songs a bit softer than the greetings
+            music.setVolume(v, v);
+            music.setOnCompletionListener(mp -> {
+                track = (track + 1) % PLAYLIST.length;
+                startTrack(c);
+            });
+            music.start();
+            prefs(c).edit().putInt(KEY_TRACK, track).apply();
+            refreshPlayer();
+        } catch (Exception e) {
+            LimeLog.warning("CarolinaAudio: " + e);
+        }
+    }
+
+    private static void releaseMusic() {
+        if (music != null) {
+            try {
+                music.release();
+            } catch (Exception ignored) {
+            }
+            music = null;
+        }
+    }
+
+    private static void refreshPlayer() {
+        Runnable r = playerRefresh;
+        if (r != null) handler.post(r);
+    }
+
+    private static void pauseMusic() {
+        if (music != null && music.isPlaying()) {
+            music.pause();
+        }
+        refreshPlayer();
+    }
+
+    private static boolean greetingPlaying = false;
+
+    /** Call from onResume of the home screens (PC list, app list). */
+    public static void onHomeResume(Activity a) {
+        homeScreensVisible++;
+        Runnable r = playerRefreshByScreen.get(a);
+        if (r != null) { playerRefresh = r; r.run(); }
+        if (!greetedThisLaunch) {
+            greetedThisLaunch = true;
+            track = prefs(a).getInt(KEY_TRACK, 0) % PLAYLIST.length;
+            if (isGreetingOn(a)) {
+                playGreetingThenMusic(a);
+                return;
+            }
+        }
+        if (greetingPlaying) return; // music starts when the greeting ends
+        if (isMusicOn(a)) {
+            if (music == null) startTrack(a);
+            else if (!music.isPlaying()) music.start();
+        }
+    }
+
+    /** Greeting (first 5 s of "Mi luz y mi guía") softly, then the background music. */
+    private static void playGreetingThenMusic(Activity a) {
+        final Context app = a.getApplicationContext();
+        try {
+            MediaPlayer mp = MediaPlayer.create(app, R.raw.carolina_inicio);
+            if (mp == null) throw new IllegalStateException("no greeting");
+            greetingPlaying = true;
+            mp.setVolume(volume(app), volume(app));
+            mp.setOnCompletionListener(p -> {
+                p.release();
+                greetingPlaying = false;
+                // continue with the other song, so "Mi luz y mi guía" does not start again right away
+                track = prefs(app).getInt(KEY_TRACK, 1);
+                if (homeScreensVisible > 0 && isMusicOn(app) && music == null) startTrack(app);
+            });
+            mp.start();
+        } catch (Exception e) {
+            LimeLog.warning("CarolinaAudio greeting: " + e);
+            greetingPlaying = false;
+            if (isMusicOn(app) && music == null) startTrack(app);
+        }
+    }
+
+    /** Call from onPause of the home screens. */
+    public static void onHomePause() {
+        homeScreensVisible--;
+        handler.postDelayed(() -> {
+            if (homeScreensVisible <= 0) {
+                homeScreensVisible = 0;
+                pauseMusic();
+            }
+        }, 600);
+    }
+
+    // ------------------------------------------------------------ buttons (top right)
+
+    private static int dp(Context c, float v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.getResources().getDisplayMetrics());
+    }
+
+    private static StateListDrawable glass(Context c) {
+        GradientDrawable normal = new GradientDrawable();
+        normal.setColor(0x33986FF2);
+        normal.setCornerRadius(dp(c, 18));
+        normal.setStroke(dp(c, 1), 0x66C8A0FF);
+        GradientDrawable focused = new GradientDrawable();
+        focused.setColor(0x66986FF2);
+        focused.setCornerRadius(dp(c, 18));
+        focused.setStroke(dp(c, 2), 0xFFE0C8FF);
+        StateListDrawable s = new StateListDrawable();
+        s.addState(new int[]{android.R.attr.state_focused}, focused);
+        s.addState(new int[]{android.R.attr.state_selected}, focused);
+        s.addState(new int[]{android.R.attr.state_pressed}, focused);
+        s.addState(new int[]{}, normal);
+        return s;
+    }
+
+    private static TextView button(Activity a) {
+        TextView t = new TextView(a);
+        t.setTextColor(Color.WHITE);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        t.setPadding(dp(a, 14), dp(a, 6), dp(a, 14), dp(a, 6));
+        t.setFocusable(true);
+        t.setClickable(true);
+        t.setBackground(glass(a));
+        return t;
+    }
+
+    /** Top right: "mute greeting" and "support the project". Right side: Carolina's music player. */
+    public static void attachButtons(Activity a) {
+        try {
+            ViewGroup root = a.findViewById(android.R.id.content);
+            LinearLayout bar = new LinearLayout(a);
+            bar.setOrientation(LinearLayout.HORIZONTAL);
+            final TextView greeting = button(a);
+            Runnable refresh = () -> greeting.setText(isGreetingOn(a) ? R.string.carolina_greeting_on : R.string.carolina_greeting_off);
+            refresh.run();
+            greeting.setOnClickListener(v -> {
+                prefs(a).edit().putBoolean(KEY_GREETING, !isGreetingOn(a)).apply();
+                refresh.run();
+            });
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            lp.setMargins(dp(a, 6), 0, dp(a, 6), 0);
+            bar.addView(greeting, lp);
+            TextView support = button(a);
+            support.setText("Apoyar el proyecto 💜");
+            support.setOnClickListener(v -> CarolinaSupport.showDialog(a));
+            bar.addView(support, lp);
+            FrameLayout.LayoutParams flp = new FrameLayout.LayoutParams(
+                    ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.END);
+            flp.setMargins(0, dp(a, 12), dp(a, 16), 0);
+            root.addView(bar, flp);
+            attachPlayer(a, root);
+        } catch (Exception e) {
+            LimeLog.warning("CarolinaAudio buttons: " + e);
+        }
+    }
+
+    // ------------------------------------------------------------ music player (right side)
+
+    private static final int PLAYER_WIDTH_DP = 280;
+
+    private static TextView playerButton(Activity a, String text, float sp) {
+        TextView t = button(a);
+        t.setText(text);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setGravity(Gravity.CENTER);
+        return t;
+    }
+
+    private static void play(Context c, int newTrack) {
+        prefs(c).edit().putBoolean(KEY_MUSIC, true).apply();
+        track = (newTrack + PLAYLIST.length) % PLAYLIST.length;
+        startTrack(c);
+    }
+
+    private static void togglePlay(Context c) {
+        if (music != null && music.isPlaying()) {
+            // paused stays paused, also after closing Carolina, until the user presses play again
+            prefs(c).edit().putBoolean(KEY_MUSIC, false).apply();
+            pauseMusic();
+        } else {
+            prefs(c).edit().putBoolean(KEY_MUSIC, true).apply();
+            if (music == null) startTrack(c);
+            else music.start();
+        }
+        refreshPlayer();
+    }
+
+    private static void attachPlayer(Activity a, ViewGroup root) {
+        // leave room on the right so the PC / game list is not hidden behind the player
+        if (root.getChildCount() > 0) {
+            View content = root.getChildAt(0);
+            // Carolina background (logo top-left), and room so the lists start below the logo
+            content.setBackgroundResource(R.drawable.carolina_home);
+            content.setPadding(content.getPaddingLeft(), content.getPaddingTop() + dp(a, 105),
+                    content.getPaddingRight() + dp(a, PLAYER_WIDTH_DP + 24), content.getPaddingBottom());
+        }
+
+        LinearLayout panel = new LinearLayout(a);
+        panel.setOrientation(LinearLayout.VERTICAL);
+        panel.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 14));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0xB3140C28);
+        bg.setCornerRadius(dp(a, 22));
+        bg.setStroke(dp(a, 1), 0x88C8A0FF);
+        panel.setBackground(bg);
+
+        TextView title = new TextView(a);
+        title.setText("🎵  Música de Carolina");
+        title.setTextColor(0xFFEBD7FF);
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
+        title.setPadding(dp(a, 4), 0, 0, dp(a, 8));
+        panel.addView(title);
+
+        final TextView[] rows = new TextView[PLAYLIST.length];
+        for (int i = 0; i < PLAYLIST.length; i++) {
+            final int idx = i;
+            TextView row = button(a);
+            row.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+            row.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 10));
+            row.setOnClickListener(v -> {
+                if (idx == track && music != null) togglePlay(a);
+                else play(a, idx);
+            });
+            LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            rlp.setMargins(0, dp(a, 3), 0, dp(a, 3));
+            panel.addView(row, rlp);
+            rows[i] = row;
+        }
+
+        LinearLayout controls = new LinearLayout(a);
