+    private void page(int d) {
+        if (!guideOpen || choices != null) return;
+        guidePage = (guidePage + d + 4) % 4;
+        if (!PcBindings.editable(guidePage, guideSlot)) moveSlot(1);
+        renderGuide();
+    }
+
+    // order used when moving up/down: left column of the picture first, then the right one
+    private static final int[] SLOT_ORDER = {PcBindings.GUIDE, PcBindings.LT, PcBindings.LB, PcBindings.VIEW, PcBindings.LS,
+            PcBindings.L3, PcBindings.DPAD, PcBindings.RT, PcBindings.RB, PcBindings.MENU, PcBindings.Y, PcBindings.X,
+            PcBindings.B, PcBindings.A, PcBindings.RS, PcBindings.R3};
+
+    private void moveSlot(int d) {
+        int pos = 0;
+        for (int i = 0; i < SLOT_ORDER.length; i++) if (SLOT_ORDER[i] == guideSlot) pos = i;
+        for (int n = 0; n < SLOT_ORDER.length; n++) {
+            pos = (pos + d + SLOT_ORDER.length) % SLOT_ORDER.length;
+            if (PcBindings.editable(guidePage, SLOT_ORDER[pos])) break;
+        }
+        guideSlot = SLOT_ORDER[pos];
+        renderGuide();
+    }
