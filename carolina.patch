+            for (int r = 0; r < cells[c].length; r++) {
+                TextView tv = cells[c][r];
+                tv.setText(columns.get(c).get(r).label.get());
+                if (colSel && r == row) {
+                    tv.setBackground(glass(0x66AA78FF, 0xCCE0C8FF, 12, 2));
+                    final android.widget.ScrollView sv = scrolls[c];
+                    sv.post(() -> {
+                        int top = tv.getTop(), bottom = tv.getBottom(), h = sv.getHeight(), y = sv.getScrollY();
+                        if (top < y) sv.smoothScrollTo(0, top);
