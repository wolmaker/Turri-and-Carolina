diff --git a/app/src/main/java/com/limelight/CarolinaMenu.java b/app/src/main/java/com/limelight/CarolinaMenu.java
new file mode 100644
index 0000000..b1ad2c2
--- /dev/null
+++ b/app/src/main/java/com/limelight/CarolinaMenu.java
@@ -0,0 +1,921 @@
+package com.limelight;
+
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.limelight.binding.input.PcBindings;
+import com.limelight.nvstream.input.ControllerPacket;
+import com.limelight.profiles.ProfilesManager;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Carolina's in-game menu: five "glass" columns over the Carolina background,
+ * fully usable with the controller (D-pad / A / B / LB / RB) and with the TV remote.
+ * Also contains the button guide ("Guía de combinaciones de botones").
+ */
+public class CarolinaMenu {
+    private static final int PURPLE = 0xFF9870F2;
+
+    private interface Label { String get(); }
+
+    private static class Item {
+        final Label label;
+        final Runnable action;
+        final boolean keepOpen;
+        Item(Label l, Runnable a, boolean keepOpen) { label = l; action = a; this.keepOpen = keepOpen; }
+    }
+
+    private final Game game;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final List<String> titles = new ArrayList<>();
+    private final List<List<Item>> columns = new ArrayList<>();
+
+    private boolean open = false;
+    private int col = 0, row = 0;
+    private int prevMap = 0;
+
+    private FrameLayout root;
+    private TextView[][] cells;
+    private LinearLayout[] panels;
+    private android.widget.ScrollView[] scrolls;
+
+    // Guide
+    private boolean guideOpen = false;
+    private int guidePage = 0;
+    private FrameLayout guideRoot;
+    private FrameLayout supportRoot;
+    private FrameLayout helpRoot;
+    // settings box (Video column)
+    private FrameLayout settingsRoot;
+    private Setting[] settings;
+    private TextView[] settingRows;
+    private int settingIdx = 0;
+    private boolean settingsChanged = false;
+    private android.widget.ScrollView helpScroll;
+    private final PcBindings bindings;
+    private int guideSlot = PcBindings.A;
+    private boolean guideEdit = false;   // false = only look at the guide, true = change buttons
+    // chooser (list of actions for the selected button)
+    private PcBindings.Action[] choices;
+    private int choiceIdx = 0;
+
+    public CarolinaMenu(Game game) {
+        this.game = game;
+        this.bindings = new PcBindings(game);
+        build();
+    }
+
+    // ------------------------------------------------------------ menu content
+
+    private String s(int id) { return game.getString(id); }
+
+    private SharedPreferences prefs() {
+        return ProfilesManager.getInstance().getOverlayingSharedPreferences(game);
+    }
+
+    private Label pct(String title, String key, int def) {
+        return () -> title + ": " + prefs().getInt(key, def) + "%";
+    }
+
+    private Runnable cycle(String key, int def, int step, int min, int max) {
+        return () -> {
+            int v = prefs().getInt(key, def) + step;
+            if (v > max) v = min;
+            prefs().edit().putInt(key, v).apply();
+            game.reloadPcModeSettings();
+        };
+    }
+
+    private void add(int column, Label l, Runnable a, boolean keepOpen) {
+        columns.get(column).add(new Item(l, a, keepOpen));
+    }
+
+    private void build() {
+        String[] t = {"Funciones", "Video", "Teclado y mouse", "Mando", "Red"};
+        for (String x : t) { titles.add(x); columns.add(new ArrayList<>()); }
+
+        // 1. Funciones y salir
+        add(0, () -> s(R.string.game_menu_disconnect), game::disconnect, false);
+        add(0, () -> s(R.string.game_menu_quit_session), game::quit, false);
+        add(0, () -> "Modo PC: " + (game.isPcModeActive() ? "activado" : "desactivado"), game::togglePcMode, true);
+        add(0, () -> s(R.string.game_menu_pc_keyboard), game::openPcKeyboard, false);
+        add(0, () -> "Guía de combinaciones de botones", this::openHelpBox, true);
+        add(0, () -> "Estadísticas en pantalla: " + (game.isHudVisible() ? "visibles" : "ocultas"), game::toggleHUD, true);
+        add(0, () -> "Apoyar el proyecto 💜", this::openSupport, true);
+        add(0, () -> "Menú original", game::showClassicMenu, false);
+        add(0, () -> "Volver al juego", null, false);
+
+        // 2. Video
+        add(1, () -> s(R.string.game_menu_restart_video), game::restartVideo, false);
+        add(1, () -> "Resolución, FPS y tasa de bits…", () -> openSettingsBox("Resolución, FPS y tasa de bits", new Setting[]{
+                listSetting("Resolución", "list_resolution", "1280x720", R.array.resolution_names, R.array.resolution_values),
+                listSetting("Cuadros por segundo (FPS)", "list_fps", "60", R.array.fps_names, R.array.fps_values),
+                bitrateSetting(),
+                listSetting("Ritmo de cuadros", "frame_pacing", "latency", R.array.video_frame_pacing_names, R.array.video_frame_pacing_values),
+        }, null, null), true);
+        add(1, () -> "Códec y HDR…", () -> openSettingsBox("Códec y HDR", new Setting[]{
+                listSetting("Códec de video", "video_format", "auto", R.array.video_format_names, R.array.video_format_values),
+                boolSetting("HDR", "checkbox_enable_hdr", false),
+        }, null, null), true);
+        add(1, () -> "Ajuste de imagen…", () -> openSettingsBox("Ajuste de imagen", new Setting[]{
+                listSetting("Ajuste a la pantalla", "list_video_scale_mode", "fit", R.array.video_scale_mode_names, R.array.video_scale_mode_values),
+                intSetting("Escala de resolución", "seekbar_resolution_scale_factor", 100, 5, 20, 200, "%"),
+        }, null, null), true);
+        add(1, () -> "Todas las opciones de video…", game::openAllSettingsAndResume, false);
+
+        // 3. Teclado y mouse (applied immediately)
+        add(2, pct("Velocidad del puntero", "seekbar_pc_mouse_speed", 60), cycle("seekbar_pc_mouse_speed", 60, 10, 10, 100), true);
+        add(2, pct("Aceleración", "seekbar_pc_mouse_accel", 50), cycle("seekbar_pc_mouse_accel", 50, 10, 0, 100), true);
+        add(2, pct("Desplazamiento", "seekbar_pc_scroll_speed", 80), cycle("seekbar_pc_scroll_speed", 80, 10, 10, 100), true);
+        add(2, pct("Zona muerta izquierda", "seekbar_pc_deadzone_left", 24), cycle("seekbar_pc_deadzone_left", 24, 2, 10, 40), true);
+        add(2, pct("Zona muerta derecha", "seekbar_pc_deadzone_right", 27), cycle("seekbar_pc_deadzone_right", 27, 2, 10, 40), true);
+        add(2, () -> s(R.string.game_menu_pc_keyboard), game::openPcKeyboard, false);
+
+        // 4. Mando
+        add(3, () -> "Cambiar botones del mando", () -> openGuide(true), true);
+        add(3, () -> "Restablecer todos los botones", () -> {
+            bindings.resetAll();
+            game.reloadPcModeSettings();
+            android.widget.Toast.makeText(game, "Botones del Modo PC restablecidos", android.widget.Toast.LENGTH_SHORT).show();
+        }, true);
+        add(3, () -> "Vibración: " + (prefs().getBoolean("checkbox_enable_rumble", true) ? "activada" : "desactivada"),
+                () -> prefs().edit().putBoolean("checkbox_enable_rumble", !prefs().getBoolean("checkbox_enable_rumble", true)).apply(), true);
+        add(3, () -> "Opciones del mando…", () -> openSettingsBox("Opciones del mando", new Setting[]{
+                boolSetting("Intercambiar A/B y X/Y", "checkbox_flip_face_buttons", false),
+                boolSetting("Varios mandos a la vez", "checkbox_multi_controller", true),
+                intSetting("Zona muerta de los sticks", "seekbar_deadzone", 5, 1, 0, 20, "%"),
+                boolSetting("Mensajes de diagnóstico del mando", "checkbox_diag_messages", true),
+        }, "Aplicar ahora (reconecta unos segundos)", "Los cambios se guardan y se notan al reconectar."), true);
+        add(3, () -> "Todas las opciones del mando…", game::openAllSettingsAndResume, false);
+
+        // 5. Red
+        add(4, () -> "Estadísticas de conexión: " + (game.isHudVisible() ? "visibles" : "ocultas"), game::toggleHUD, true);
+        add(4, () -> "Latencia y ancho de banda…", () -> openSettingsBox("Latencia y ancho de banda", new Setting[]{
+                bitrateSetting(),
+                boolSetting("Latencia ultra baja", "checkbox_ultra_low_latency", false),
+                boolSetting("Evitar pérdida de paquetes", "checkbox_prevent_packet_loss", false),
+                listSetting("Ritmo de cuadros", "frame_pacing", "latency", R.array.video_frame_pacing_names, R.array.video_frame_pacing_values),
+        }, null, null), true);
+        add(4, () -> "Estadísticas en pantalla…", () -> openSettingsBox("Estadísticas en pantalla", new Setting[]{
+                boolSetting("Mostrar al empezar a jugar", "checkbox_enable_perf_overlay", false),
+                boolSetting("Versión compacta", "checkbox_enable_perf_overlay_lite", false),
+                boolSetting("Mostrarlas abajo", "checkbox_enable_perf_overlay_bottom", false),
+        }, null, null), true);
+        add(4, () -> "Todas las opciones de red…", game::openAllSettingsAndResume, false);
+    }
+
+    // ------------------------------------------------------------ open / close
+
+    public boolean isOpen() { return open; }
+
+    public void open() {
+        handler.post(() -> {
+            if (open) return;
+            open = true;
+            col = 0; row = 0;
+            prevMap = 0;
+            show();
+        });
+    }
+
+    public void close() {
+        handler.post(() -> {
+            open = false;
+            guideOpen = false;
+            if (root != null && root.getParent() instanceof ViewGroup) ((ViewGroup) root.getParent()).removeView(root);
+            root = null;
+            guideRoot = null;
+            supportRoot = null;
+            helpRoot = null;
+            settingsRoot = null;
+        });
+    }
+
+    // ------------------------------------------------------------ input
+
+    /** Controller input (any controller type, incl. Carolina's USB driver). */
+    public void onGamepad(int map) {
+        int pressed = map & ~prevMap;
+        prevMap = map;
+        if (pressed == 0) return;
+        handler.post(() -> {
+            if (has(pressed, ControllerPacket.UP_FLAG)) nav(0, -1);
+            if (has(pressed, ControllerPacket.DOWN_FLAG)) nav(0, 1);
+            if (has(pressed, ControllerPacket.LEFT_FLAG)) nav(-1, 0);
+            if (has(pressed, ControllerPacket.RIGHT_FLAG)) nav(1, 0);
+            if (has(pressed, ControllerPacket.LB_FLAG)) page(-1);
+            if (has(pressed, ControllerPacket.RB_FLAG)) page(1);
+            if (has(pressed, ControllerPacket.A_FLAG)) select();
+            if (has(pressed, ControllerPacket.B_FLAG)) back();
+            if (has(pressed, ControllerPacket.Y_FLAG)) resetSelected();
+        });
+    }
+
+    /** TV remote / keyboard keys. Returns true if consumed. */
+    public boolean onRemoteKey(int keyCode) {
+        switch (keyCode) {
+            case KeyEvent.KEYCODE_DPAD_UP: handler.post(() -> nav(0, -1)); return true;
+            case KeyEvent.KEYCODE_DPAD_DOWN: handler.post(() -> nav(0, 1)); return true;
+            case KeyEvent.KEYCODE_DPAD_LEFT: handler.post(() -> nav(-1, 0)); return true;
+            case KeyEvent.KEYCODE_DPAD_RIGHT: handler.post(() -> nav(1, 0)); return true;
+            case KeyEvent.KEYCODE_DPAD_CENTER:
+            case KeyEvent.KEYCODE_ENTER: handler.post(this::select); return true;
+            case KeyEvent.KEYCODE_BACK:
+            case KeyEvent.KEYCODE_ESCAPE: handler.post(this::back); return true;
+            default: return true; // swallow other keys while the menu is open
+        }
+    }
+
+    private static boolean has(int m, int f) { return (m & f) != 0; }
+
+    private void nav(int dc, int dr) {
+        if (supportRoot != null) return;
+        if (settingsRoot != null) {
+            int n = settings.length + 2;
+            if (dr != 0) settingIdx = (settingIdx + dr + n) % n;
+            if (dc != 0 && settingIdx < settings.length) { settings[settingIdx].change(dc); settingsChanged = true; }
+            renderSettings();
+            return;
+        }
+        if (helpRoot != null) {
+            if (dr != 0 && helpScroll != null) helpScroll.smoothScrollBy(0, dr * dp(90));
+            return;
+        }
+        if (guideOpen) {
+            if (choices != null) {
+                if (dr != 0) { choiceIdx = (choiceIdx + dr + choices.length) % choices.length; renderGuide(); }
+                return;
+            }
+            if (dc != 0) page(dc);
+            if (dr != 0 && guideEdit) moveSlot(dr);
+            return;
+        }
+        if (dc != 0) {
+            col = (col + dc + columns.size()) % columns.size();
+            row = Math.min(row, columns.get(col).size() - 1);
+        }
+        if (dr != 0) {
