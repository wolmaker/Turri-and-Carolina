diff --git a/src_assets/common/assets/web/public/assets/css/turri.css b/src_assets/common/assets/web/public/assets/css/turri.css
new file mode 100644
index 0000000..f293a7b
--- /dev/null
+++ b/src_assets/common/assets/web/public/assets/css/turri.css
@@ -0,0 +1,84 @@
+/* Turri: gold "glass" theme over the Turri background */
+:root, [data-bs-theme="light"], [data-bs-theme="dark"] {
+  --turri-gold: #FBB71B;
+  --turri-gold-soft: #ffd77a;
+  --bs-primary: #FBB71B;
+  --bs-primary-rgb: 251, 183, 27;
+  --bs-link-color: #FBB71B;
+  --bs-link-color-rgb: 251, 183, 27;
+  --bs-link-hover-color: #ffd36b;
+  --bs-body-color: #f3ead6;
+  --bs-body-color-rgb: 243, 234, 214;
+  --bs-secondary-color: rgba(243, 234, 214, .70);
+  --bs-tertiary-color: rgba(243, 234, 214, .55);
+  --bs-emphasis-color: #fff6e0;
+  --bs-heading-color: #ffd77a;
+  --bs-body-bg: #05040a;
+  --bs-border-color: rgba(251, 183, 27, .22);
+}
+
+body {
+  background: #05040a url('../../images/turri-bg.webp') center / cover fixed no-repeat !important;
+  color: var(--bs-body-color);
+  min-height: 100vh;
+}
+
+.navbar, .navbar-background {
+  background: rgba(20, 14, 4, .45) !important;
+  -webkit-backdrop-filter: blur(14px);
+  backdrop-filter: blur(14px);
+  border-bottom: 1px solid rgba(251, 183, 27, .25);
+}
+.navbar .nav-link, .navbar-brand, .navbar-text { color: #ffe7b0 !important; }
+.navbar .nav-link:hover, .navbar .nav-link.active { color: var(--turri-gold) !important; }
+.navbar-toggler-icon { filter: invert(1) sepia(1) saturate(4) hue-rotate(5deg); }
+
+/* glass panels */
+.card, .list-group-item, .modal-content, .dropdown-menu, .accordion-item, .accordion-button,
+.alert, .toast, .popover, .offcanvas, .table, .config-page {
+  background-color: rgba(251, 183, 27, .06) !important;
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+  border: 1px solid rgba(251, 183, 27, .22) !important;
+  color: var(--bs-body-color) !important;
+}
+.card, .modal-content, .alert, .accordion-item, .config-page { border-radius: 18px !important; }
+.card-header, .card-footer, .modal-header, .modal-footer { background: rgba(251, 183, 27, .08) !important; border-color: rgba(251, 183, 27, .2) !important; }
+
+h1, h2, h3, h4 { color: var(--turri-gold-soft); text-shadow: 0 0 18px rgba(251, 170, 20, .35); }
+
+/* forms */
+.form-control, .form-select, .input-group-text {
+  background-color: rgba(10, 8, 2, .55) !important;
+  color: var(--bs-body-color) !important;
+  border: 1px solid rgba(251, 183, 27, .30) !important;
+  border-radius: 12px;
+}
+.form-control::placeholder { color: rgba(243, 234, 214, .45); }
+.form-control:focus, .form-select:focus {
+  border-color: var(--turri-gold) !important;
+  box-shadow: 0 0 0 .2rem rgba(251, 183, 27, .25) !important;
+}
+.form-check-input:checked { background-color: var(--turri-gold); border-color: var(--turri-gold); }
+.form-text, .text-muted { color: rgba(243, 234, 214, .65) !important; }
+
+/* buttons */
+.btn { border-radius: 12px; }
+.btn-primary, .btn-success {
+  background: var(--turri-gold) !important; border-color: var(--turri-gold) !important; color: #1a1204 !important;
+}
+.btn-primary:hover, .btn-success:hover { background: #ffcf5a !important; border-color: #ffcf5a !important; }
+.btn-secondary, .btn-outline-secondary, .btn-light {
+  background: rgba(251, 183, 27, .10) !important; border: 1px solid rgba(251, 183, 27, .35) !important; color: #ffe7b0 !important;
+}
+.btn-danger { border-radius: 12px; }
+
+/* tabs */
+.nav-tabs, .nav-pills { border-color: rgba(251, 183, 27, .25) !important; }
+.nav-tabs .nav-link, .nav-pills .nav-link { color: #ffe7b0 !important; border-radius: 12px 12px 0 0; }
+.nav-tabs .nav-link.active, .nav-pills .nav-link.active {
+  background: rgba(251, 183, 27, .18) !important; color: var(--turri-gold) !important; border-color: rgba(251, 183, 27, .35) !important;
+}
+
+pre, code { color: #ffe7b0; }
+pre { background: rgba(10, 8, 2, .6) !important; border-radius: 12px; border: 1px solid rgba(251, 183, 27, .2); }
